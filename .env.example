# Where prices come from: yahoo (real, ~15 min delayed) | demo (simulated, no network)
DATA_PROVIDER=yahoo

# Seconds between refreshes. Defaults: 60 for yahoo (its data only changes every ~15 min), 1 for demo.
# POLL_SECONDS=60

# The dashboard password. Leave unset on your own laptop if you like; REQUIRED before hosting it online.
# DASHBOARD_PASSWORD=choose-a-long-password

# Signs the login cookie. Optional: if unset, a random one is made at each start.
# A login lives only while a page is open on it, and a server restart ends every login either way.
# SESSION_SECRET=paste-a-long-random-string-here

# Who may reach the server (read by start.bat). 127.0.0.1 = this computer only (default).
# 0.0.0.0 = also other devices on the same network, e.g. your phone or another laptop at home.
# Set a password before opening it up.
# HOST=0.0.0.0
# PORT=8000

# Dhan, the owner's broker API, for licensed real-time data (step 1: the connection).
# Client id from the Dhan website (Profile > DhanHQ Trading APIs); the access token from the
# same page lasts 24 hours, so paste a fresh one each trading morning. Run check_dhan.bat to test.
# Needs the Data API subscription on the Dhan account. Only data is read; no order is ever placed.
# DHAN_CLIENT_ID=1000000000
# DHAN_ACCESS_TOKEN=paste-the-long-token-here
# DHAN_POLL_SECONDS=15     how often the index page refreshes its candles and calls on Dhan
# DHAN_TICK_SECONDS=1      how often the live price is read while an index page is open in market hours
# SELL_SHARE=0.5           the Sell mark: when an option's premium is at or below this share of what was paid
